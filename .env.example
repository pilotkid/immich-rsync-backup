# Copy these settings INTO your existing Immich Compose .env file.
# Do not commit the populated .env or backup secrets.
# Uses your existing UPLOAD_LOCATION from Immich.

BACKUP_IMAGE=immich-rsync-backup:local
TZ=America/Denver
BACKUP_TIME=03:00
RUN_ON_START=false
SOURCE_DIRS=upload library profile backups
REQUIRE_DB_BACKUP=true
DB_BACKUP_MAX_AGE_HOURS=48
# Optional: request a fresh dump before each rsync run. Create an Immich API key
# with job creation permission and store it in backup-secrets/immich-api-key.
TRIGGER_DB_BACKUP=false
IMMICH_API_URL=http://immich-server:2283/api
IMMICH_API_KEY_FILE=/run/rsync-secrets/immich-api-key
# Alternatively, set IMMICH_API_KEY directly and leave IMMICH_API_KEY_FILE empty.
DB_BACKUP_TRIGGER_TIMEOUT_SECONDS=1800

# Amazon EC2 rsync-over-SSH server (N. Virginia example; not an S3 bucket):
RSYNC_DESTINATION=ec2-user@ec2-YOUR_INSTANCE.compute-1.amazonaws.com:/srv/backups/immich
RSYNC_PROFILE=standard
BACKUP_MODE=append
SSH_PORT=22
# Use a verified backup-config/known_hosts before connecting over SSH.
# For a mounted private key:
# SSH_IDENTITY_FILE=/config/id_ed25519
# For a remote requiring password authentication instead of a key:
# RSYNC_SSH_PASSWORD_FILE=/run/rsync-secrets/password
# Or set RSYNC_SSH_PASSWORD directly and leave RSYNC_SSH_PASSWORD_FILE empty.

# For an rsync daemon running on EC2, use a URL such as:
# RSYNC_DESTINATION=rsync://ec2-user@ec2-YOUR_INSTANCE.compute-1.amazonaws.com/my-module/immich
# RSYNC_DAEMON_PASSWORD_FILE=/run/rsync-secrets/password

# Mount backup-config/id_ed25519 and use this path for key authentication:
# SSH_IDENTITY_FILE=/config/id_ed25519
