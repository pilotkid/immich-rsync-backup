# Copy this file to .env, then replace every placeholder.
# Use absolute host paths for these storage locations.
IMMICH_VERSION=release
UPLOAD_LOCATION=/path/to/immich/library
DB_DATA_LOCATION=/path/to/immich/postgres
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-long-random-password
DB_DATABASE_NAME=immich

# Backup schedule and Immich database dump trigger
TZ=America/Denver
BACKUP_TIME=03:00
RUN_ON_START=false
TRIGGER_DB_BACKUP=true
IMMICH_API_URL=http://immich-server:2283/api
DB_BACKUP_TRIGGER_TIMEOUT_SECONDS=1800
REQUIRE_DB_BACKUP=true
DB_BACKUP_MAX_AGE_HOURS=48
SOURCE_DIRS=upload library profile backups

# Amazon EC2 rsync-over-SSH server in N. Virginia (this is not an S3 bucket).
# Replace the host with your instance's current public DNS name.
RSYNC_DESTINATION=ec2-user@ec2-YOUR_INSTANCE.compute-1.amazonaws.com:/srv/backups/immich
RSYNC_PROFILE=standard
BACKUP_MODE=append
SSH_PORT=22
SSH_IDENTITY_FILE=/config/id_ed25519
